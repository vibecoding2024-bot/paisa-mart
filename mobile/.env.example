# Paisa Mart app — example build environment (names only; NEVER put secrets here).
# EXPO_PUBLIC_* values are compiled into the app and visible to anyone, so they must never hold private keys.
# Production builds: set the API URL to https://paisa-mart.com. Test builds: a local/test API and EXPO_PUBLIC_TEST_ENV=1
# (a test build refuses to start if it would use production; see mobile/src/lib/api-base.ts).
EXPO_PUBLIC_API_URL=https://paisa-mart.com
EXPO_PUBLIC_BACKEND_URL=https://paisa-mart.com
EXPO_PUBLIC_VIBECODE_BACKEND_URL=https://paisa-mart.com
EXPO_PUBLIC_TEST_ENV=
# MSG91 OTP widget identifiers (designed for client-side use).
EXPO_PUBLIC_MSG91_WEB_WIDGET_ID=
EXPO_PUBLIC_MSG91_WEB_WIDGET_TOKEN_AUTH=
