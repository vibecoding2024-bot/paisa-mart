# Paisa Mart backend — example environment (names only; NEVER put real values in Git).
# Copy to backend/.env (ignored by Git) on the server, mode 600, and fill in values there.
# Production values live only in /home/ec2-user/paisa-mart-new/backend/.env on the EC2 host.

# --- Server ---
PORT=3000
NODE_ENV=production
BACKEND_URL=https://paisa-mart.com
PUBLIC_BACKEND_URL=https://paisa-mart.com

# --- SQLite (production: /home/ec2-user/paisa-mart-data/payments.db) ---
TXN_DB=
LEADS_DB=
USER_DB=
# Leave every *_DATABASE_URL / POSTGRES_URL unset to use SQLite.
DATABASE_URL=
POSTGRES_URL=
PERSONAL_LOANS_DATABASE_URL=
BUSINESS_LOANS_DATABASE_URL=
HOME_LOANS_DATABASE_URL=
VEHICLE_LOANS_DATABASE_URL=

# --- App secrets (generate each with: openssl rand -base64 48) ---
AUTH_TOKEN_SECRET=
HOME_LOAN_ADMIN_TOKEN_SECRET=
HOME_LOAN_ADMIN_PASSWORD=
ADMIN_EMAIL=

# --- MSG91 OTP (dashboard: msg91.com). Never set ALLOW_DEV_OTP in production. ---
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SERVER_KEY=
MSG91_WIDGET_TOKEN_AUTH=
MSG91_MOBILE_AUTH_KEY=
MSG91_MOBILE_OTP_TEMPLATE_ID=
MSG91_MOBILE_WIDGET_ID=
MSG91_MOBILE_WIDGET_SERVER_KEY=
MSG91_MOBILE_WIDGET_TOKEN_AUTH=
MSG91_WEB_AUTH_KEY=
MSG91_WEB_OTP_TEMPLATE_ID=
MSG91_WEB_WIDGET_ID=
MSG91_WEB_WIDGET_SERVER_KEY=
MSG91_WEB_WIDGET_TOKEN_AUTH=
EXPO_PUBLIC_MSG91_MOBILE_WIDGET_ID=
EXPO_PUBLIC_MSG91_WEB_WIDGET_ID=
ALLOW_DEV_OTP=

# --- VimoPay payment gateway (rotate: see docs/security/KEY_ROTATION_2026-11-22.md) ---
VIMOPAY_BASE_URL=https://gateway.vimopay.in
VIMOPAY_USER_ID=
VIMOPAY_SECRET_KEY=
VIMOPAY_SALT_KEY=
VIMOPAY_ED_KEY=
# Extra allowlisted hosts for the gateway paymentUrl (comma-separated), only if VimoPay uses another domain.
VIMOPAY_PAYMENT_URL_HOSTS=

# --- VimoPay KYC ---
VIMOPAY_KYC_START_URL=
VIMOPAY_KYC_URL_TEMPLATE=
VIMOPAY_KYC_STATUS_URL=
VIMOPAY_KYC_CALLBACK_URL=
VIMOPAY_KYC_API_KEY=
VIMOPAY_KYC_AUTH_TOKEN=
VIMOPAY_KYC_STATE_SECRET=

# --- Google Play review account (see docs/play-store-remediation-20261122/REVIEWER_ACCESS_DESIGN.md) ---
REVIEW_ACCOUNT_ENABLED=false
REVIEW_ACCOUNT_PHONE=
REVIEW_ACCOUNT_HMAC_KEY=
REVIEW_ACCOUNT_CODE_HASH=
REVIEW_ACCOUNT_EXPIRES_AT=
